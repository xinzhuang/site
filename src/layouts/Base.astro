---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Developer tools for AI-powered workflows' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | AgentTools</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <nav class="container">
      <div class="nav-inner">
        <a href="/" class="logo">
          <span class="logo-icon">⚡</span> AgentTools
        </a>
        <div class="nav-links">
          <a href="/">Tools</a>
          <a href="https://github.com/xinzhuang" target="_blank">GitHub ↗</a>
        </div>
      </div>
    </nav>
    <main>
      <slot />
    </main>
    <footer class="container">
      <div class="footer-inner">
        <p>© 2026 xinzhuang · Built with Astro</p>
        <div class="footer-links">
          <a href="https://github.com/xinzhuang" target="_blank">GitHub</a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';

  nav {
    padding: 20px 0;
    border-bottom: 1px solid var(--color-border);
    backdrop-filter: blur(12px);
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(5, 5, 5, 0.8);
  }
  .nav-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .logo {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-text);
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .logo:hover { color: var(--color-text); }
  .logo-icon {
    font-size: 1.1rem;
  }
  .nav-links {
    display: flex;
    gap: 28px;
  }
  .nav-links a {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    font-weight: 500;
  }
  .nav-links a:hover { color: var(--color-text); }

  main {
    min-height: 80vh;
  }

  footer {
    padding: 40px 0;
    border-top: 1px solid var(--color-border);
  }
  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .footer-inner p {
    color: var(--color-text-subtle);
    font-size: 0.85rem;
  }
  .footer-links {
    display: flex;
    gap: 20px;
  }
  .footer-links a {
    color: var(--color-text-subtle);
    font-size: 0.85rem;
  }
  .footer-links a:hover { color: var(--color-text-muted); }

  @media (max-width: 640px) {
    .footer-inner {
      flex-direction: column;
      gap: 12px;
      text-align: center;
    }
  }
</style>
