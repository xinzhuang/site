---
import Base from '../../layouts/Base.astro';
---

<Base title="OpenClaw Model Manager" description="Visual model config manager for OpenClaw AI agents">
  <section class="product container">
    <a href="/" class="back">← All Tools</a>

    <div class="hero">
      <span class="badge" style="color: var(--color-amber); background: rgba(245,158,11,0.1);">Beta</span>
      <h1>OpenClaw Model Manager</h1>
      <p class="tagline">Visual model configuration manager for OpenClaw AI agents — manage providers, models & agent bindings through a clean web dashboard.</p>
      <div class="actions">
        <a href="https://github.com/xinzhuang/openclaw-model-manager" target="_blank" class="btn btn-primary">GitHub ↗</a>
        <a href="#quickstart" class="btn btn-secondary">Get Started</a>
      </div>
    </div>

    <div class="features-grid">
      <div class="feature">
        <div class="feature-icon">🔧</div>
        <h3>Provider Management</h3>
        <p>Configure built-in providers (OpenAI, Anthropic, Google Gemini) or add custom ones with your own base URL and API type.</p>
      </div>
      <div class="feature">
        <div class="feature-icon">📦</div>
        <h3>Model Management</h3>
        <p>Add models with fine-grained settings: reasoning, vision, context window, max tokens, and cost parameters.</p>
      </div>
      <div class="feature">
        <div class="feature-icon">🤖</div>
        <h3>Agent Binding</h3>
        <p>Bind primary and fallback model chains per agent. Configure image models and reasoning levels independently.</p>
      </div>
      <div class="feature">
        <div class="feature-icon">🔐</div>
        <h3>Auth Monitoring</h3>
        <p>View and monitor authentication status for each agent, including expiration states at a glance.</p>
      </div>
      <div class="feature">
        <div class="feature-icon">🌐</div>
        <h3>Bilingual UI</h3>
        <p>Full i18n support with English and Chinese interfaces. Switch languages on the fly.</p>
      </div>
      <div class="feature">
        <div class="feature-icon">📄</div>
        <h3>Single-File Build</h3>
        <p>Production output is a single HTML with all assets inlined. Deploy anywhere, zero dependencies.</p>
      </div>
    </div>

    <div class="architecture">
      <h2>Architecture</h2>
      <div class="arch-diagram">
        <div class="arch-layer">
          <div class="arch-label">Frontend</div>
          <div class="arch-items">
            <span class="arch-tag">React SPA</span>
            <span class="arch-tag">Vite Build</span>
            <span class="arch-tag">i18n (en/zh)</span>
          </div>
        </div>
        <div class="arch-arrow">↕ REST API</div>
        <div class="arch-layer">
          <div class="arch-label">Backend (:3457)</div>
          <div class="arch-items">
            <span class="arch-tag">Express</span>
            <span class="arch-tag">Atomic Config Write</span>
            <span class="arch-tag">Auto Backup</span>
          </div>
        </div>
        <div class="arch-arrow">↕ Read/Write</div>
        <div class="arch-layer">
          <div class="arch-label">Config</div>
          <div class="arch-items">
            <span class="arch-tag">~/.openclaw/openclaw.json</span>
          </div>
        </div>
      </div>
    </div>

    <div class="quickstart" id="quickstart">
      <h2>Quick Start</h2>
      <div class="code-block">
        <code>
          <span class="cmd">git clone</span> https://github.com/xinzhuang/openclaw-model-manager.git<br/>
          <span class="cmd">cd</span> openclaw-model-manager<br/>
          <span class="cmd">npm install</span><br/>
          <span class="cmd">npm link</span><br/><br/>
          <span class="comment"># Start the dashboard</span><br/>
          <span class="cmd">omm start</span>
        </code>
      </div>
    </div>
  </section>
</Base>

<style>
  .product { padding: 40px 0 80px; }
  .back {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    display: inline-block;
    margin-bottom: 32px;
    font-weight: 500;
  }
  .back:hover { color: var(--color-text); }

  .hero {
    text-align: center;
    padding: 40px 0 64px;
  }
  .badge {
    font-size: 0.8rem;
    font-weight: 600;
    display: inline-block;
    margin-bottom: 16px;
    padding: 4px 14px;
    border-radius: 100px;
  }
  h1 {
    font-size: 2.8rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .tagline {
    font-size: 1.15rem;
    color: var(--color-text-muted);
    margin-top: 16px;
    max-width: 560px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.6;
  }
  .actions {
    margin-top: 28px;
    display: flex;
    justify-content: center;
    gap: 12px;
  }
  .btn {
    padding: 10px 24px;
    border-radius: var(--radius-sm);
    font-weight: 600;
    font-size: 0.95rem;
    transition: all var(--transition);
  }
  .btn-primary {
    background: var(--color-accent);
    color: white;
  }
  .btn-primary:hover { background: var(--color-accent-hover); color: white; }
  .btn-secondary {
    border: 1px solid var(--color-border);
    color: var(--color-text);
  }
  .btn-secondary:hover { border-color: var(--color-text-muted); color: var(--color-text); }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
  }
  .feature {
    padding: 28px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    transition: border-color var(--transition);
  }
  .feature:hover {
    border-color: var(--color-border-hover);
  }
  .feature-icon {
    font-size: 1.5rem;
    margin-bottom: 12px;
  }
  .feature h3 {
    font-size: 1.05rem;
    font-weight: 700;
    margin-bottom: 8px;
  }
  .feature p {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .architecture {
    margin-top: 64px;
  }
  .architecture h2 {
    font-size: 1.4rem;
    font-weight: 700;
    margin-bottom: 16px;
    letter-spacing: -0.01em;
  }
  .arch-diagram {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .arch-layer {
    padding: 20px 24px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
  }
  .arch-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-subtle);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 10px;
  }
  .arch-items {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .arch-tag {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    padding: 4px 12px;
    border-radius: 100px;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }
  .arch-arrow {
    text-align: center;
    padding: 8px 0;
    font-size: 0.8rem;
    color: var(--color-text-subtle);
    font-weight: 500;
  }

  .quickstart {
    margin-top: 64px;
  }
  .quickstart h2 {
    font-size: 1.4rem;
    font-weight: 700;
    margin-bottom: 16px;
    letter-spacing: -0.01em;
  }
  .code-block {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 28px;
    font-family: 'SF Mono', 'Fira Code', 'Cascadia Code', monospace;
    font-size: 0.88rem;
    line-height: 1.8;
    overflow-x: auto;
  }
  .cmd {
    color: var(--color-accent);
    font-weight: 600;
  }
  .comment {
    color: var(--color-text-subtle);
  }
</style>
