---
import Base from '../../layouts/Base.astro';
---

<Base title="RepoLens" description="AI-powered GitHub repository analyzer">
  <section class="product container">
    <a href="/" class="back">← All Tools</a>
    
    <div class="hero">
      <span class="badge">🟢 Live</span>
      <h1>RepoLens</h1>
      <p class="tagline">AI-powered GitHub repository analyzer — instant insights for any repo.</p>
      <div class="actions">
        <a href="https://github.com/xinzhuang/repolens" target="_blank" class="btn btn-primary">GitHub</a>
        <a href="#" class="btn btn-secondary">Try it</a>
      </div>
    </div>

    <div class="features-grid">
      <div class="feature">
        <h3>🔍 Repo Analysis</h3>
        <p>Deep analysis of repository structure, patterns, and architecture decisions.</p>
      </div>
      <div class="feature">
        <h3>🤖 AI Summary</h3>
        <p>Instant AI-generated summaries that help you understand any repo in seconds.</p>
      </div>
      <div class="feature">
        <h3>🛠 Tech Stack Detection</h3>
        <p>Automatically identifies languages, frameworks, and dependencies.</p>
      </div>
      <div class="feature">
        <h3>📊 Code Metrics</h3>
        <p>Code quality, complexity, and contributor statistics at a glance.</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .product { padding: 40px 0 80px; }
  .back {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    display: inline-block;
    margin-bottom: 32px;
  }
  .hero {
    text-align: center;
    padding: 40px 0 60px;
  }
  .badge {
    font-size: 0.85rem;
    display: inline-block;
    margin-bottom: 12px;
  }
  h1 {
    font-size: 2.5rem;
    font-weight: 800;
  }
  .tagline {
    font-size: 1.15rem;
    color: var(--color-text-muted);
    margin-top: 12px;
    max-width: 480px;
    margin-left: auto;
    margin-right: auto;
  }
  .actions {
    margin-top: 24px;
    display: flex;
    justify-content: center;
    gap: 12px;
  }
  .btn {
    padding: 10px 24px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.95rem;
    transition: all 0.2s;
  }
  .btn-primary {
    background: var(--color-accent);
    color: white;
  }
  .btn-primary:hover { background: var(--color-accent-hover); color: white; }
  .btn-secondary {
    border: 1px solid var(--color-border);
    color: var(--color-text);
  }
  .btn-secondary:hover { border-color: var(--color-text-muted); color: var(--color-text); }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 20px;
  }
  .feature {
    padding: 24px;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-surface);
  }
  .feature h3 {
    font-size: 1.05rem;
    margin-bottom: 8px;
  }
  .feature p {
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }
</style>
