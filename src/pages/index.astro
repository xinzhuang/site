---
import Base from '../layouts/Base.astro';
import ToolCard from '../components/ToolCard.astro';
import type { Tool } from '../content';

const tools: Tool[] = [
  {
    id: 'repolens',
    name: 'RepoLens',
    description: 'Local git repository search engine — find your projects instantly with FTS5 full-text indexing.',
    url: 'https://repolens.agenttools.qzz.io',
    github: 'https://github.com/xinzhuang/repolens',
    status: 'live',
    features: ['FTS5 Search', 'Agent-native', 'Rich Fingerprints', 'Zero Config'],
  },
  {
    id: 'openclaw-model-manager',
    name: 'OpenClaw Model Manager',
    description: 'Visual model configuration manager for OpenClaw AI agents — manage providers, models & agent bindings.',
    url: 'https://github.com/xinzhuang/openclaw-model-manager',
    github: 'https://github.com/xinzhuang/openclaw-model-manager',
    status: 'beta',
    features: ['Provider Management', 'Model Config', 'Agent Binding', 'Bilingual UI'],
  },
];
---

<Base title="Home" description="Developer tools for AI-powered workflows — by xinzhuang">
  <section class="hero container">
    <div class="hero-badge">Open Source Tools</div>
    <h1>
      Developer Tools<br/>
      <span class="accent">for AI Workflows</span>
    </h1>
    <p class="subtitle">
      A collection of tools built by <a href="https://github.com/xinzhuang" target="_blank" class="author-link">xinzhuang</a> to make developers more productive with AI.
    </p>
  </section>

  <section class="tools container">
    <div class="section-header">
      <h2>Tools</h2>
      <span class="count">{tools.length} tools</span>
    </div>
    <div class="grid">
      {tools.map((tool) => (
        <ToolCard {...tool} />
      ))}
    </div>
  </section>
</Base>

<style>
  .hero {
    padding: 100px 0 80px;
    text-align: center;
    position: relative;
  }
  .hero-badge {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-accent);
    background: var(--color-accent-glow);
    padding: 6px 16px;
    border-radius: 100px;
    border: 1px solid rgba(59, 130, 246, 0.2);
    margin-bottom: 24px;
    letter-spacing: 0.02em;
  }
  h1 {
    font-size: 3.2rem;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
  }
  .accent {
    background: linear-gradient(135deg, var(--color-accent), var(--color-purple));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .subtitle {
    margin-top: 20px;
    font-size: 1.15rem;
    color: var(--color-text-muted);
    max-width: 520px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.6;
  }
  .author-link {
    font-weight: 600;
    color: var(--color-text);
    border-bottom: 1px solid var(--color-border);
    transition: border-color var(--transition);
  }
  .author-link:hover {
    color: var(--color-text);
    border-color: var(--color-accent);
  }

  .tools {
    padding: 20px 0 100px;
  }
  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 28px;
  }
  .section-header h2 {
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .count {
    font-size: 0.85rem;
    color: var(--color-text-subtle);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 20px;
  }

  @media (max-width: 640px) {
    h1 { font-size: 2.2rem; }
    .hero { padding: 60px 0 50px; }
    .grid { grid-template-columns: 1fr; }
  }
</style>
