---
import Base from '../layouts/Base.astro';
import ToolCard from '../components/ToolCard.astro';
import type { Tool } from '../content';

const tools: Tool[] = [
  {
    id: 'repolens',
    name: 'RepoLens',
    description: 'AI-powered GitHub repository analyzer — instant insights for any repo.',
    url: 'https://repolens.agenttools.qzz.io',
    github: 'https://github.com/xinzhuang/repolens',
    status: 'live',
    features: ['Repo Analysis', 'AI Summary', 'Tech Stack Detection', 'Code Metrics'],
  },
  // 未来工具在这里添加
];
---

<Base title="Home" description="Developer tools for AI-powered workflows — by xinzhuang">
  <section class="hero container">
    <h1>Developer Tools<br/><span class="accent">for AI Workflows</span></h1>
    <p class="subtitle">A collection of tools built by <a href="https://github.com/xinzhuang" target="_blank">xinzhuang</a> to make developers more productive.</p>
  </section>

  <section class="tools container">
    <h2>Tools</h2>
    <div class="grid">
      {tools.map((tool) => (
        <ToolCard {...tool} />
      ))}
    </div>
  </section>
</Base>

<style>
  .hero {
    padding: 80px 0 60px;
    text-align: center;
  }
  h1 {
    font-size: 3rem;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }
  .accent {
    background: linear-gradient(135deg, #3b82f6, #8b5cf6);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .subtitle {
    margin-top: 16px;
    font-size: 1.15rem;
    color: var(--color-text-muted);
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
  }

  .tools {
    padding: 40px 0 80px;
  }
  .tools h2 {
    font-size: 1.5rem;
    margin-bottom: 24px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 20px;
  }
</style>
