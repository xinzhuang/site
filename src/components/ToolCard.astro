---
interface Props {
  name: string;
  id: string;
  description: string;
  url: string;
  github: string;
  status: string;
  features: string[];
}

const { name, id, description, url, github, status, features } = Astro.props;

const statusConfig: Record<string, { label: string; color: string; bg: string }> = {
  'live': { label: 'Live', color: 'var(--color-emerald)', bg: 'rgba(16, 185, 129, 0.1)' },
  'beta': { label: 'Beta', color: 'var(--color-amber)', bg: 'rgba(245, 158, 11, 0.1)' },
  'coming-soon': { label: 'Soon', color: 'var(--color-text-muted)', bg: 'rgba(136, 136, 136, 0.1)' },
};
const s = statusConfig[status] || statusConfig['coming-soon'];
---

<a href={`/tools/${id}`} class="tool-card">
  <div class="tool-header">
    <h3>{name}</h3>
    <span class="status" style={`color: ${s.color}; background: ${s.bg}`}>{s.label}</span>
  </div>
  <p class="desc">{description}</p>
  <div class="features">
    {features.map((f) => <span class="tag">{f}</span>)}
  </div>
  <div class="card-footer">
    <span class="link-hint">View details →</span>
  </div>
</a>

<style>
  .tool-card {
    display: flex;
    flex-direction: column;
    padding: 28px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    transition: all var(--transition);
    position: relative;
    overflow: hidden;
  }
  .tool-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at top left, var(--color-accent-glow), transparent 60%);
    opacity: 0;
    transition: opacity var(--transition);
  }
  .tool-card:hover {
    border-color: var(--color-border-hover);
    transform: translateY(-3px);
    color: var(--color-text);
  }
  .tool-card:hover::before {
    opacity: 1;
  }
  .tool-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
    position: relative;
  }
  .tool-header h3 {
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .status {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 100px;
    letter-spacing: 0.02em;
  }
  .desc {
    color: var(--color-text-muted);
    font-size: 0.92rem;
    margin-bottom: 16px;
    position: relative;
    line-height: 1.5;
  }
  .features {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    position: relative;
  }
  .tag {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    padding: 4px 12px;
    border-radius: 100px;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }
  .card-footer {
    margin-top: auto;
    padding-top: 20px;
    position: relative;
  }
  .link-hint {
    font-size: 0.85rem;
    color: var(--color-accent);
    font-weight: 500;
    transition: color var(--transition);
  }
  .tool-card:hover .link-hint {
    color: var(--color-accent-hover);
  }
</style>
